# 简历服务（server/index.js）配置模板。
#
# 用法：复制本文件为 .env，按需修改。.env 已被 .gitignore 忽略，不会进版本库。
# 命令行临时覆盖仍可用 $env:PORT=3002; npm run pdf（Windows PowerShell）。

# ---------- 网络 ----------

# 监听端口，需与 vite.config.js 里的 PDF_PORT 一致
PORT=3001

# 监听地址。127.0.0.1 表示仅本机可访问。
# 改成 0.0.0.0 对外暴露时，/api 一律要求登录（或脚本口令），匿名请求返回 401。
HOST=127.0.0.1

# 开发服务器端口，启动时用它探测渲染源
DEV_PORT=5173

# 前面有反向代理（Nginx / Caddy 终止 TLS）时设为 1，
# req.ip / req.secure 才按 X-Forwarded-* 解析；直接暴露时保持留空，
# 否则客户端可伪造 X-Forwarded-For 绕过注册限频与登录锁定。
# TRUST_PROXY=1

# 公网域名部署时放行浏览器 Origin（逗号分隔），否则登录与导出会被 403。
# 例：ALLOWED_ORIGINS=https://resume.example.com
# ALLOWED_ORIGINS=

# ---------- 账号 ----------

# 账号系统始终开启：开放注册（限每小时 5 次/IP），会话有效期 30 天，
# 数据库默认在 server/.data/app.db（可整目录挂卷/备份）。
# DB_PATH=D:/data/resume-app.db

# ---------- 脚本口令（可选） ----------

# Bearer 通道口令，供 curl 等脚本调用 /api/pdf 使用；留空表示关闭该通道，
# 账号登录不受影响。设置后：连续错误 10 次锁定 15 分钟。
# 注意：口令在 HTTP 上是明文传输的，只在回环访问或前置 TLS 时有保护意义。
PDF_ACCESS_PASSWORD=

# ---------- 额度 ----------

# 每用户每日导出上限（登录用户与脚本口令各自计数）
PDF_USER_DAILY_LIMIT=10

# 全站每日导出总额度，作为成本兜底；计数据库持久化，跨天自动归零
PDF_DAILY_LIMIT=100

# ---------- 渲染并发 ----------

# 同时渲染的浏览器页面上限。小内存机器（2-4G）保持 1 即可，
# 配 2G swap 更稳；内存充裕可调到 2-3。
RENDER_CONCURRENCY=1

# 渲染排队上限，超过直接返回 429「排队已满」
RENDER_QUEUE_MAX=3

# ---------- 渲染源（可选） ----------

# 显式指定渲染源，跳过自动探测。留空则依次尝试 DEV_PORT 与自身端口。
# RENDER_URL=http://localhost:5173/

# ---------- 渲染内核（可选） ----------

# 指定 Chromium 内核浏览器可执行文件；留空则按 msedge → chrome 探测。
# BROWSER_PATH=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe

# 追加浏览器启动参数（空格分隔）。容器内需要 --no-sandbox 时从这里进；
# 应用默认已带 --disable-dev-shm-usage（容器 /dev/shm 兜底），无需重复设置。
# BROWSER_EXTRA_ARGS=--no-sandbox
