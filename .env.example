# PDF 渲染服务（server/index.js）配置模板。
#
# 用法：复制本文件为 .env，按需修改。.env 已被 .gitignore 忽略，不会进版本库。
# 命令行临时覆盖仍可用 $env:PORT=3002; npm run pdf（Windows PowerShell）。

# ---------- 网络 ----------

# 监听端口，需与 vite.config.js 里的 PDF_PORT 一致
PORT=3001

# 监听地址。127.0.0.1 表示仅本机可访问。
# 改成 0.0.0.0 或局域网 IP 会对外暴露服务，此时下面必须设置 PDF_ACCESS_PASSWORD，
# 否则服务会拒绝启动——这个进程能启动浏览器、能访问本机文件与内网。
HOST=127.0.0.1

# 开发服务器端口，启动时用它探测渲染源
DEV_PORT=5173

# ---------- 访问口令 ----------

# /api/pdf 的访问口令。留空表示不校验，仅可与回环监听搭配使用。
#
# 设置后：前端首次点击「一键导出」会弹出输入框，口令随 Authorization: Bearer 发送，
# 服务端用常量时间比较校验，连续错误 10 次将锁定 15 分钟。
#
# 注意：口令在 HTTP 上是明文传输的。只在两种场景下有实际保护意义——
#   1) 本机回环访问；
#   2) 前面有一层反向代理（Nginx / Caddy）终止 TLS。
# 直接以 HTTP 暴露到公网，口令会被链路上任何一跳抓走。
PDF_ACCESS_PASSWORD=

# ---------- 额度 ----------

# 每个自然日的导出上限，计数落盘在 server/.data/quota.json，重启不重置
PDF_DAILY_LIMIT=20

# ---------- 渲染源（可选） ----------

# 显式指定渲染源，跳过自动探测。留空则依次尝试 DEV_PORT 与自身端口。
# RENDER_URL=http://localhost:5173/
