{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    // server 由 node 直接执行（v22 的类型剥离），相对导入必须写全 .ts 扩展名，
    // 否则运行时解析不到；该选项只在 noEmit 下可用，正好符合本项目的用法
    "allowImportingTsExtensions": true,
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "noUnusedLocals": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.js"],
  "exclude": ["node_modules", "dist"]
}
