# PDF 渲染服务的每日配额计数（本机运行状态，不入库）
server/.data/

# PDF 服务的本地环境变量，含访问口令，禁止入库；
# .env.example 是不含真实口令的模板，需要入库供他人复制
.env
.env.*
!.env.example

# nginx 入口的证书与私钥（nginx/default.conf 是配置模板，要入库）
nginx/certs/

# 本地 GUI 测试截图
gui-test-screenshots

# Python 工具脚本（tools/ 下生成 favicon 的脚本）产生的字节码缓存
__pycache__/
*.pyc

# 审计截图（tools/audit-ui.mjs --shots 的产物，本地看，不入库）
tools/shots/
# 启动性能 trace（tools/trace-startup.mjs 的产物，本地分析用）
tools/trace/
