{
  "name": "vue-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k -n web,pdf -c cyan,green \"vite\" \"node --env-file-if-exists=.env server/index.js\"",
    "build": "vite build",
    "preview": "vite preview",
    "pdf": "node --env-file-if-exists=.env server/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write --experimental-cli src server tests \"*.js\" \"*.md\"",
    "format:check": "prettier --check --experimental-cli src server tests \"*.js\" \"*.md\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "prettier --write --experimental-cli",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write --experimental-cli"
    ]
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-draggable-plus": "^0.6.0",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "3.9.6",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
