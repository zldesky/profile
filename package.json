{
  "name": "vue-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k -n web,pdf -c cyan,green \"vite\" \"node --env-file-if-exists=.env server/index.ts\"",
    "build": "vite build",
    "preview": "vite preview",
    "pdf": "node --env-file-if-exists=.env server/index.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write --experimental-cli src server tests \"*.js\" \"*.md\"",
    "format:check": "prettier --check --experimental-cli src server tests \"*.js\" \"*.md\"",
    "prepare": "husky",
    "typecheck": "vue-tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "audit:login": "node tools/audit-login.mjs",
    "audit:ui": "node tools/audit-ui.mjs",
    "audit:el": "node tools/probe-el.mjs",
    "audit:session": "node tools/probe-session.mjs",
    "audit:perf": "node tools/probe-perf.mjs",
    "audit:mobile": "node tools/probe-mobile.mjs",
    "audit:trace": "node tools/trace-startup.mjs",
    "audit:shot": "node tools/shoot-pages.mjs",
    "audit:dialog": "node tools/shoot-dialog.mjs",
    "audit:interaction": "node tools/audit-interaction.mjs",
    "audit:admin": "node tools/audit-admin.mjs",
    "verify:templates": "node tools/verify-templates.mjs",
    "verify:dialogs": "node tools/verify-dialogs.mjs",
    "verify:captcha": "node tools/verify-captcha.mjs",
    "verify:paper": "node tools/verify-paper-edit.mjs",
    "verify:drag-ux": "node tools/verify-paper-drag-ux.mjs",
    "verify:drag": "node tools/verify-drag.mjs",
    "verify:selects": "node tools/verify-selects.mjs",
    "verify:panel": "node tools/verify-panel-resize.mjs",
    "verify:markdown": "node tools/verify-markdown-roundtrip.mjs",
    "verify:pdf": "node tools/verify-pdf-export.mjs",
    "verify:pages": "node tools/verify-page-count-agreement.mjs",
    "verify:share": "node tools/verify-share-privacy.mjs",
    "build:host-template": "node tools/build-host-template.mjs",
    "preview:host-theme": "node tools/preview-host-theme.mjs"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "prettier --write --experimental-cli",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write --experimental-cli"
    ]
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-draggable-plus": "^0.6.0",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "3.9.6",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
